# ============================================================
#  Plantilla de variables de entorno de SercaProp
#
#  Cómo usarla:
#    1. Copia este archivo como .env   (cp .env.example .env)
#    2. Rellena los valores marcados como "CAMBIAR"
#    3. Nunca subas .env al repositorio (ya está en .gitignore)
#
#  En producción (Railway) no se usa este archivo: las variables se definen
#  en el panel del servicio. settings.py carga .env solo para rellenar lo que
#  falte, sin pisar lo que ya venga del entorno.
# ============================================================

# ── Django ──────────────────────────────────────────────────
# CAMBIAR en producción: genera una nueva con
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion

# True en desarrollo, False en producción.
# Con False se activan SSL obligatorio y cookies seguras.
DJANGO_DEBUG=True

# Dominios separados por coma, sin espacios.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos ───────────────────────────────────────────
# Déjalo comentado en local: se usa SQLite (db.sqlite3).
# En Railway la inyecta la plataforma al vincular el Postgres; no la pongas aquí.
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd
#
# Solo para consultar producción desde tu PC. Requiere que el Postgres tenga
# el TCP Proxy habilitado (Railway → Postgres → Settings → Networking).
# DATABASE_PUBLIC_URL=postgresql://usuario:password@host:puerto/nombre_bd

# ── Cloudinary (imágenes y documentos) ──────────────────────
# Se puede dar la URL completa o las tres partes por separado.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=cambiar
CLOUDINARY_API_KEY=cambiar
CLOUDINARY_API_SECRET=cambiar

# ── Correo saliente ─────────────────────────────────────────
# EMAIL_BACKEND=resend envía por la API HTTP de Resend en vez de SMTP
# (evita los timeouts de SMTP desde los servidores de Railway).
# Para desarrollo, deja EMAIL_BACKEND vacío para usar la consola o Gmail.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=cambiar@ejemplo.cl
EMAIL_HOST_PASSWORD=cambiar
# Key de Resend. Si está vacía se reutiliza EMAIL_HOST_PASSWORD.
RESEND_API_KEY=
EMAIL_DEFAULT_FROM=Serca Propiedades <noreply@ejemplo.cl>
EMAIL_NOREPLY_FROM=Serca Propiedades <noreply@ejemplo.cl>

# ── Sitio ───────────────────────────────────────────────────
SITE_DOMAIN=localhost
# ID de Google Analytics 4 (G-XXXXXXXXXX). Vacío lo desactiva.
GA4_MEASUREMENT_ID=

# ── Login social (opcional) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
